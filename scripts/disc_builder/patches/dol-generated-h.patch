 }
 
+/* A1: cycle-budgeted batch. Identical per-block semantics to
+ * dolrecomp_run_blocks (every block still goes through the full
+ * dolrecomp_call chain), but the loop ends on the guest-cycle charge instead
+ * of a fixed block count: the chassis regains control once the accumulated
+ * charge crosses the same budget an in-chunk loop back-edge already uses,
+ * so CoreTiming/interrupt latency keeps its existing worst case. A block
+ * that cannot be handled natively (hooked/demoted/uncovered pc) returns 0
+ * with ctx->pc set, exactly like the single-block path. */
+static inline DOLRECOMP_UNUSED int dolrecomp_run_budget(CPUState* ctx, s64 budget) {
+    /* Iteration cap (review §3.2): a verified chunk entered at a non-entry
+     * pc (wild computed jump to mid-chunk data) returns with zero charge —
+     * without this bound the loop livelocks unresponsively, where the old
+     * per-block path still re-checked CPU::State each dispatch. */
+    for (int i = 0; i < 4096; ++i) {
+        if (!dolrecomp_call(ctx, ctx->pc)) return 0;
+        if (ctx->exception) return 0;
+        if (ctx->downcount <= -budget) return 1;
+    }
+    return 1; /* hand control back to the chassis; it decides what to do */
+}
