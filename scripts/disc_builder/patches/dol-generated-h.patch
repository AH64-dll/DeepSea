+/* A1 batch-dispatch channel: the chassis installs g_mg_native_ok through the
+ * ppc_set_native_check export. The query answers EXACTLY the predicate the
+ * chassis evaluates at every block boundary before re-entering the module:
+ *   module_active && fast_dispatchable_at(pc) && !IsHostCallAddress(pc)
+ * (verified, non-demoted, non-forced-fallback chunk AND no mod hook/patch/
+ * pending-return at pc — HandlesAddress covers all three).
+ *
+ * When armed, dolrecomp_call consults it INSTEAD of the ppc_host_call probe:
+ *  - query true  -> the block is plain native code; find_original runs it.
+ *    ppc_host_call is provably a no-op here (Dispatch's hooks/patches/
+ *    pending-returns are all inside the query's IsHostCallAddress term), so
+ *    skipping it is bit-exact.
+ *  - query false -> return 0 with ctx->pc set. The chassis then does
+ *    precisely what it would have done had the previous block boundary
+ *    stopped there: entry-hook addresses run through host_call + the demoted
+ *    chunk falls back to the JIT, patched addresses run the patch, pending
+ *    return hooks fire, uncovered/uncached addresses hit the interpreter.
+ * The replacement dispatcher keeps its first-place ordering, so an address
+ * that is both replaced and hooked behaves as before (replacement wins).
+ *
+ * When NOT armed (older chassis / no query installed) the original
+ * ppc_host_call path runs unchanged. */
+#define DOLRECOMP_A1_BATCH 1
+extern int (*g_mg_native_ok)(u32 address, void* user);
+extern void* g_mg_native_ok_user;
+
 static inline int dolrecomp_call(CPUState* ctx, u32 address) {
     u32 alias;
     ctx->pc = address;
     if (dolrecomp_dispatch_replacement(ctx, address)) return 1;
-    if (ctx->host_call && ppc_host_call(ctx, address)) return 1;
+    if (g_mg_native_ok) {
+        if (!g_mg_native_ok(address, g_mg_native_ok_user)) return 0;
+    } else if (ctx->host_call && ppc_host_call(ctx, address)) {
+        return 1;
+    }
     if (dolrecomp_call_original(ctx, address)) return 1;
     if (dolrecomp_physical_pc_alias(ctx, address, &alias)) {
         ctx->pc = alias;
         if (dolrecomp_dispatch_replacement(ctx, alias)) return 1;
-        if (ctx->host_call && ppc_host_call(ctx, alias)) return 1;
+        if (g_mg_native_ok) {
+            if (!g_mg_native_ok(alias, g_mg_native_ok_user)) return 0;
+        } else if (ctx->host_call && ppc_host_call(ctx, alias)) {
+            return 1;
+        }
         if (dolrecomp_call_original(ctx, alias)) return 1;
     }
     return 0;
@@ -602,6 +636,27 @@
